ability\":\"view\",\"type\":\"function\",\"name\":\"owner\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}]},{\"inputs\":[],\"stateMutability\":\"pure\",\"type\":\"function\",\"name\":\"renounceOwnership\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"newWindow\",\"type\":\"uint256\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\",\"name\":\"setLivenessWindow\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"newOwner\",\"type\":\"address\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\",\"name\":\"transferOwnership\"},{\"inputs\":[],\"stateMutability\":\"pure\",\"type\":\"function\",\"name\":\"version\",\"outputs\":[{\"internalType\":\"string\",\"name\":\"\",\"type\":\"string\"}]}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{\"attestLiveness(uint256,bytes32)\":{\"details\":\"FRESHNESS BINDING (M-01): the caller must echo the hash of a recent block. A blockhash is      unpredictable until its block exists, and `blockhash()` only exposes the last 256 blocks,      so a transaction CANNOT be pre-signed to cover a future period — the signer must have      observed a block within the last `MAX_ATTEST_ANCHOR_AGE` blocks. This ties \\\"live\\\" to      recent signing capability and defeats a keeper replaying a batch of stale, pre-authorized      attestations to keep an abandoned-key operator in the live-set. (It does NOT, by itself,      stop an operator whose key is genuinely online but which refuses to co-sign slashes — that      residual griefer is caught at the DVT layer by excluding recent non-participants.)      Still cheap: one `blockhash` read + one warm SSTORE. Permissionless; consumers decide which      addresses count. A v2 MAY add a BLS-aggregated batch form.\",\"params\":{\"anchorBlock\":\"a recent block in `[block.number - MAX_ATTEST_ANCHOR_AGE, block.number - 1]`.\",\"anchorHash\":\"must equal `blockhash(anchorBlock)`.\"}},\"constructor\":{\"params\":{\"governance\":\"owner authorized to change the window; SHOULD be a TimelockController /        multisig (shrinking the window is fleet-sensitive). Ownable reverts on the zero owner.\",\"initialWindow\":\"starting fleet-wide window in blocks; must be within bounds.\"}},\"isOffline(address)\":{\"details\":\"Uses `block.number` (the executing block) so an archival `eth_call` pinned to a finalized      epoch reproduces the exact live-set for that epoch. Written as `block.number - last` (NOT      `last + _livenessWindow`) so the arithmetic is overflow-proof for ALL inputs: `last <=      block.number` makes the subtraction safe, whereas `last + window` could in principle      overflow near `uint256.max`.\"},\"lastLive(address)\":{\"details\":\"Exposed for forensics / alerting (who went offline, from which block) and to make the      live-set denominator auditable. Not part of any slash content-address (no offline slash).\"},\"livenessWindow()\":{\"details\":\"Governance-set and identical for the whole DVT fleet (NOT per-community) so every      co-signer computes the same live-set; DVT reads it (pinned to the same epoch block).\"},\"owner()\":{\"details\":\"Returns the address of the current owner.\"},\"transferOwnership(address)\":{\"details\":\"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner.\"}},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"MAX_ATTEST_ANCHOR_AGE()\":{\"notice\":\"Max age (in blocks) of the freshness anchor {attestLiveness} may reference. Bounded by         the EVM's 256-block `blockhash` window.\"},\"MAX_LIVENESS_WINDOW()\":{\"notice\":\"Upper bound on {livenessWindow} — fat-finger guard against an absurd value.\"},\"MIN_LIVENESS_WINDOW()\":{\"notice\":\"Lower bound on {livenessWindow} — blocks a value so small a single missed ping would         mass-jail the fleet.\"},\"areOffline(address[])\":{\"notice\":\"Batch form of {isOffline} — one call to build a full live-set denominator.\"},\"attestLiveness(uint256,bytes32)\":{\"notice\":\"Prove the caller is live *now*. Records `lastLive[msg.sender] = block.number`.\"},\"isOffline(address)\":{\"notice\":\"True iff `operator` is offline as of the block this call executes against.\"},\"lastLive(address)\":{\"notice\":\"Block number of `operator`'s most recent attestation (0 = never attested).\"},\"livenessWindow()\":{\"notice\":\"Fleet-wide liveness window, in blocks. offline ⇔ `blockNumber − lastLive > window`.\"},\"renounceOwnership()\":{\"notice\":\"Disabled: renouncing ownership would freeze {livenessWindow} at its current value         forever, permanently locking the live-set partition — a governance footgun. Transfer         to a new timelock / multisig via {transferOwnership} instead. Always reverts.\"},\"setLivenessWindow(uint256)\":{\"notice\":\"Set the fleet-wide liveness window (blocks). Owner-only; owner SHOULD be a         TimelockController / multisig because SHRINKING the window is fleet-sensitive         (a sudden shrink can flip many operators to offline at once). Bounded to         [MIN_LIVENESS_WINDOW, MAX_LIVENESS_WINDOW] as a fat-finger guard.\"},\"version()\":{\"notice\":\"Contract version (see CLAUDE.md versioning convention).\"}},\"version\":1}},\"settings\":{\"remappings\":[\"@account-abstraction-v7/=singleton-paymaster/lib/account-abstraction-v7/contracts/\",\"@chainlink/contracts/=contracts/lib/chainlink-brownie-contracts/contracts/\",\"@openzeppelin-v5.0.2/=singleton-paymaster/lib/openzeppelin-contracts-v5.0.2/\",\"@openzeppelin/contracts/=singleton-paymaster/lib/openzeppelin-contracts-v5.0.2/contracts/\",\"account-abstraction-v6/=singleton-paymaster/lib/account-abstraction-v6/contracts/\",\"account-abstraction-v7/=singleton-paymaster/lib/account-abstraction-v7/contracts/\",\"account-abstraction-v8/=singleton-paymaster/lib/account-abstraction-v8/contracts/\",\"chainlink-brownie-contracts/=contracts/lib/chainlink-brownie-contracts/contracts/src/v0.6/vendor/@arbitrum/nitro-contracts/src/\",\"ds-test/=singleton