.sol\":{\"keccak256\":\"0x493033a8d1b176a037b2cc6a04dad01a5c157722049bbecf632ca876224dd4b2\",\"urls\":[\"bzz-raw://6a708e8a5bdb1011c2c381c9a5cfd8a9a956d7d0a9dc1bd8bcdaf52f76ef2f12\",\"dweb:/ipfs/Qmax9WHBnVsZP46ZxEMNRQpLQnrdE4dK8LehML1Py8FowF\"],\"license\":\"MIT\"}},\"version\":1},\"storageLayout\":{\"storage\":[{\"astId\":174416,\"contract\":\"contracts/src/core/LivenessRegistry.sol:LivenessRegistry\",\"label\":\"_owner\",\"offset\":0,\"slot\":\"0\",\"type\":\"t_address\"},{\"astId\":45782,\"contract\":\"contracts/src/core/LivenessRegistry.sol:LivenessRegistry\",\"label\":\"_livenessWindow\",\"offset\":0,\"slot\":\"1\",\"type\":\"t_uint256\"},{\"astId\":45787,\"contract\":\"contracts/src/core/LivenessRegistry.sol:LivenessRegistry\",\"label\":\"_lastLive\",\"offset\":0,\"slot\":\"2\",\"type\":\"t_mapping(t_address,t_uint256)\"}],\"types\":{\"t_address\":{\"encoding\":\"inplace\",\"label\":\"address\",\"numberOfBytes\":\"20\"},\"t_mapping(t_address,t_uint256)\":{\"encoding\":\"mapping\",\"key\":\"t_address\",\"label\":\"mapping(address => uint256)\",\"numberOfBytes\":\"32\",\"value\":\"t_uint256\"},\"t_uint256\":{\"encoding\":\"inplace\",\"label\":\"uint256\",\"numberOfBytes\":\"32\"}}},\"id\":31}", ".deployedBytecode.immutableReferences") [staticcall]
