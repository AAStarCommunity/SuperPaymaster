"address\",\"internalType\":\"address\"}]},{\"type\":\"error\",\"name\":\"OwnableUnauthorizedAccount\",\"inputs\":[{\"name\":\"account\",\"type\":\"address\",\"internalType\":\"address\"}]},{\"type\":\"error\",\"name\":\"RenounceDisabled\",\"inputs\":[]},{\"type\":\"error\",\"name\":\"StaleAnchor\",\"inputs\":[{\"name\":\"anchorBlock\",\"type\":\"uint256\",\"internalType\":\"uint256\"}]}],\"bytecode\":{\"object\":\"\",\"sourceMap\":\"4016:8060:31:-:0;;;;;;;;;;;;;-1:-1:-1;;4016:8060:31;;;;-1:-1:-1;;;;;4016:8060:31;;;;;;;;;;;;;;;;;;;;;;;;;-1:-1:-1;;;;;4016:8060:31;;;;;;;;;;;;1273:26:180;;;1269:95;;-1:-1:-1;4016:8060:31;;-1:-1:-1;;;;;;4016:8060:31;;;;;;;;;;-1:-1:-1;;;;;4016:8060:31;;;;3052:40:180;;-1:-1:-1;3052:40:180;4965:3:31;11633:31;;:66;;;;-1:-1:-1;11629:128:31;;4016:8060;5240:10;11847:37;5240:10;4016:8060;5240:10;;4016:8060;5240:10;;;4016:8060;5240:10;;;11847:37;4016:8060;;;;;;;;;11629:128;11722:24;;;;-1:-1:-1;11722:24:31;;5240:10;;-1:-1:-1;11722:24:31;11633:66;11668:31;5240:10;11668:31;;11633:66;;1269:95:180;1322:31;;;-1:-1:-1;1322:31:180;-1:-1:-1;1322:31:180;4016:8060:31;;-1:-1:-1;1322:31:180;4016:8060:31;-1:-1:-1;4016:8060:31;;;;;;-1:-1:-1;4016:8060:31;;;;;-1:-1:-1;4016:8060:31\",\"linkReferences\":{}},\"deployedBytecode\":{\"object\":\"\",\"sourceMap\":\"4016:8060:31:-:0;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;-1:-1:-1;;4016:8060:31;;;;;;;5544:3;4016:8060;;;;;;;;;;;;;-1:-1:-1;;4016:8060:31;;;;;;-1:-1:-1;;;;;4016:8060:31;;;;;;;1500:62:180;;:::i;:::-;2627:22;;2623:91;;-1:-1:-1;;;;;4016:8060:31;;;;;;;;;;;3052:40:180;4016:8060:31;3052:40:180;;4016:8060:31;2623:91:180;2672:31;;;4016:8060:31;2672:31:180;4016:8060:31;;;;;2672:31:180;4016:8060:31;;;;;;-1:-1:-1;;4016:8060:31;;;;;;-1:-1:-1;;;;;4016:8060:31;;;;;;;;;9222:9;4016:8060;;;;;;;;;;;;;;;;;;;-1:-1:-1;;4016:8060:31;;;;;;;4965:3;4016:8060;;;;;;;;;-1:-1:-1;;4016:8060:31;;;;;;;5240:10;4016:8060;;;;;;;;;-1:-1:-1;;4016:8060:31;;;;;-1:-1:-1;;;;;4016:8060:31;;;;;;;;;;;;;;;-1:-1:-1;;4016:8060:31;;;;;;1500:62:180;;:::i;:::-;4965:3:31;11633:31;;:66;;;;4016:8060;11629:128;;4016:8060;11847:37;4016:8060;;;;;;;;;;;;;;;;11847:37;4016:8060;11629:128;11722:24;;;4016:8060;11722:24;4016:8060;;;;11722:24;11633:66;11668:31;5240:10;11668:31;;11633:66;;4016:8060;;;;;;-1:-1:-1;;4016:8060:31;;;;11450:18;;;4016:8060;11450:18;4016:8060;;11450:18;4016:8060;;;;;;-1:-1:-1;;4016:8060:31;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;-1:-1:-1;;4016:8060:31;;;;;;;;;;;;;;;;;;;;;;;;;-1:-1:-1;;4016:8060:31;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;:::i;:::-;;;;;;-1:-1:-1;;4016:8060:31;;;;;;;;;;;;;;;;;;;;:::i;:::-;;;;;-1:-1:-1;;4016:8060:31;;;;;10253:3;10244:7;;;;;;4016:8060;;;;;;;;;;-1:-1:-1;;;;;4016:8060:31;;;;;;10281:23;;;:::i;:::-;4016:8060;;;;;;;;;;;;;;;;;;;10233:9;;4016:8060;;;;;;;;;;;;10244:7;;;4016:8060;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;;-1:-1:-1;4016:8060:31;;;;;;;;;;;;;;;;;;;-1:-1:-1;;4016:8060:31;;;;;;-1:-1:-1;;;;;4016:8060:31;;;;;;;;;;:::i;:::-;;;;;;;;;;;;;;;-1:-1:-1;;4016:8060:31;;;;;10440:15;4016:8060;;;;;;;;;;;;;-1:-1:-1;;4016:8060:31;;;;;;8057:12;8042:27;;;;:81;;;4016:8060;8038:143;;8409:22;;8445:15;;:34;;;;;4016:8060;8441:73;;;8535:10;4016:8060;;8525:9;4016:8060;;8057:12;4016:8060;;;;;;8057:12;4016:8060;;8576:42;4016:8060;8535:10;8576:42;;4016:8060;8441:73;8488:26;;;4016:8060;8488:26;4016:8060;;;;8488:26;8445:34;4016:8060;;;;8464:15;;8445:34;;;8038:143;8146:24;;;4016:8060;8146:24;4016:8060;;;;8146:24;8042:81;8057:12;5544:3;8073:26;8057:12;;8073:26;:::i;:::-;:50;8042:81;;4016:8060;;;;;;;;;;:::o;:::-;;;;;;;;;;;;9738:273;-1:-1:-1;;;;;4016:8060:31;;;9827:9;4016:8060;;;;;;9860:9;;9856:26;;9967:19;:12;;:19;:::i;:::-;9989:15;4016:8060;-1:-1:-1;9738:273:31;:::o;9856:26::-;9871:11;9878:4;9871:11;:::o;4016:8060::-;;;;;;;;;;;:::o;1796:162:180:-;-1:-1:-1;;;;;1710:6:180;4016:8060:31;;735:10:210;1855:23:180;1851:101;;1796:162::o;1851:101::-;1901:40;;;1710:6;1901:40;735:10:210;1901:40:180;4016:8060:31;;1710:6:180;1901:40\",\"linkReferences\":{}},\"methodIdentifiers\":{\"MAX_ATTEST_ANCHOR_AGE()\":\"f901ac57\",\"MAX_LIVENESS_WINDOW()\":\"a641a722\",\"MIN_LIVENESS_WINDOW()\":\"d4dcb45a\",\"areOffline(address[])\":\"51f1fe1a\",\"attestLiveness(uint256,bytes32)\":\"0a9a8d99\",\"isOffline(address)\":\"231e0340\",\"lastLive(address)\":\"e458779b\",\"livenessWindow()\":\"15c97887\",\"owner()\":\"8da5cb5b\",\"renounceOwnership()\":\"715018a6\",\"setLivenessWindow(uint256)\":\"84dfda79\",\"transferOwnership(address)\":\"f2fde38b\",\"version()\":\"54fd4d50\"},\"rawMetadata\":\"{\\\"compiler\\\":{\\\"version\\\":\\\"0.8.33+commit.64118f21\\\"},\\\"language\\\":\\\"Solidity\\\",\\\"output\\\":{\\\"abi\\\":[{\\\"inputs\\\":[{\\\"internalType\\\":\\\"address\\\",\\\"name\\\":\\\"governance\\\",\\\"type\\\":\\\"address\\\"},{\\\"internalType\\\":\\\"uint256\\\",\\\"name\\\":\\\"initialWindow\\\",\\\"type\\\":\\\"uint256\\\"}],\\\"stateMutability\\\":\\\"nonpayable\\\",\\\"type\\\":\\\"constructor\\\"},{\\\"inputs\\\":[{\\\"internalType\\\":\\\"uint256\\\",\\\"name\\\":\\\"anchorBlock\\\",\\\"type\\\":\\\"uint256\\\"}],\\\"name\\\":\\\"BadAnchorHash\\\",\\\"type\\\":\\\"error\\\"},{\\\"inputs\\\":[{\\\"internalType\\\":\\\"uint256\\\",\\\"name\\\":\\\"window\\\",\\\"type\\\":\\\"uint256\\\"}],\\\"name\\\":\\\"InvalidWindow\\\",\\\"type\\\":\\\"error\\\"},{\\\"inputs\\\":[{\\\"internalType\\\":\\\"address\\\",\\\"name\\\":\\\"owner\\\",\\\"type\\\":\\\"address\\\"}],\\\"name\\\":\\\"OwnableInvalidOwner\\\",\\\"type\\\":\\\"error\\\"},{\\\"inputs\\\":[{\\\"internalType\\\":\\\"address\\\",\\\"name\\\":\\\"account\\\",\\\"type\\\":\\\"address\\\"}],\\\"name\\\":\\\"OwnableUnauthorizedAccount\\\",\\\"type\\\":\\\"error\\\"},{\\\"inputs\\\":[],\\\"name\\\":\\\"RenounceDisabled\\\",\\\"type\\\":\\\"error\\\"},{\\\"inputs\\\":[{\\\"internalType\\\":\\\"uint256\\\",\\\"name\\\":\\\"anchorBlock\\\",\\\"type\\\":\\\"uint256\\\"}],\\\"name\\\":\\\"StaleAnchor\\\",\\\"type\\\":\\\"error\\\"},{\\\"anonymous\\\":false,\\\"inputs\\\":[{\\\"indexed\\\":true,\\\"internalType\\\":\\\"address\\\",\\\"name\\\":\\\"operator\\\",\\\"type\\\":\\\"address\\\"},{\\\"indexed\\\":false,\\\"internalType\\\":\\\"uint256\\\",\\\"name\\\":\\\"atBlock\\\",\\\"type\\\":\\\"uint256\\\"}],\\\"name\\\":\\\"LivenessAttested\\\",\\\"type\\\":\\\"event\\\"},{\\\"anonymous\\\":false,\\\"inputs\\\":[{\\\"indexed\\\":false,\\\"internalType\\\":\\\"uint256\\\",\\\"name\\\":\\\"oldWindow\\\",\\\"type\\\":\\\"uint256\\\"},{\\\"indexed\\\":false,\\\"internalType\\\":\\\"uint256\\\",\\\"name\\\":\\\"newWindow\\\",\\\"type\\\":\\\"uint256\\\"}],\\\"name\\\":\\\"LivenessWindowUpdated\\\",\\\"type\\\":\\\"event\\\"},{\\\"anonymous\\\":false,\\\"inputs\\\":[{\\\"indexed\\\":true,\\\"internalType\\\":\\\"address\\\",\\\"name\\\":\\\"previousOwner\\\",\\\"type\\\":\\\"address\\\"},{\\\"indexed\\\":true,\\\"internalType\\\":\\\"address\\\",\\\"name\\\":\\\"newOwner\\\",\\\"type\\\":\\\"address\\\"}],\\\"name\\\":\\\"OwnershipTransferred\\\",\\\"type\\\":\\\"event\\\"},{\\\"inputs\\\":[],\\\"name\\\":\\\"MAX_ATTEST_ANCHOR_AGE\\\",\\\"outputs\\\":[{\\\"internalType\\\":\\\"uint256\\\",\\\"name\\\":\\\"\\\",\\\"type\\\":\\\"uint256\\\"}],\\\"stateMutability\\\":\\\"view\\\",\\\"type\\\":\\\"function\\\"},{\\\"inputs\\\":[],\\\"name\\\":\\\"MAX_LIVENESS_WINDOW\\\",\\\"outputs\\\":[{\\\"internalType\\\":\\\"uint256\\\",\\\"name\\\":\\\"\\\",\\\"type\\\":\\\"uint256\\\"}],\\\"stateMutability\\\":\\\"view\\\",\\\"type\\\":\\\"function\\\"},{\\\"inputs\\\":[],\\\"name\\\":\\\"MIN_LIVENESS_WINDOW\\\",\\\"outputs\\\":[{\\\"internalType\\\":\\\"uint256\\\",\\\"name\\\":\\\"\\\",\\\"type\\\":\\\"uint256\\\"}],\\\"stateMutability\\\":\\\"view\\\",\\\"type\\\":\\\"function\\\"},{\\\"inputs\\\":[{\\\"internalType\\\":\\\"address[]\\\",\\\"name\\\":\\\"operators\\\",\\\"type\\\":\\\"address[]\\\"}],\\\"name\\\":\\\"areOffline\\\",\\\"outputs\\\":[{\\\"internalType\\\":\\\"bool[]\\\",\\\"name\\\":\\\"out\\\",\\\"type\\\":\\\"bool[]\\\"}],\\\"stateMutability\\\":\\\"view\\\",\\\"type\\\":\\\"function\\\"},{\\\"inputs\\\":[{\\\"internalType\\\":\\\"uint256\\\",\\\"name\\\":\\\"anchorBlock\\\",\\\"type\\\":\\\"uint256\\\"},{\\\"internalType\\\":\\\"bytes32\\\",\\\"name\\\":\\\"anchorHash\\\",\\\"type\\\":\\\"bytes32\\\"}],\\\"name\\\":\\\"attestLiveness\\\",\\\"outputs\\\":[],\\\"stateMutability\\\":\\\"nonpayable\\\",\\\"type\\\":\\\"function\\\"},{\\\"inputs\\\":[{\\\"internalType\\\":\\\"address\\\",\\\"name\\\":\\\"operator\\\",\\\"type\\\":\\\"address\\\"}],\\\"name\\\":\\\"isOffline\\\",\\\"outputs\\\":[{\\\"internalType\\\":\\\"bool\\\",\\\"name\\\":\\\"\\\",\\\"type\\\":\\\"bool\\\"}],\\\"stateMutability\\\":\\\"view\\\",\\\"type\\\":\\\"function\\\"},{\\\"inputs\\\":[{\\\"internalType\\\":\\\"address\\\",\\\"name\\\":\\\"operator\\\",\\\"type\\\":\\\"address\\\"}],\\\"name\\\":\\\"lastLive\\\",\\\"outputs\\\":[{\\\"internalType\\\":\\\"uint256\\\",\\\"name\\\":\\\"\\\",\\\"type\\\":\\\"uint256\\\"}],\\\"stateMutability\\\":\\\"view\\\",\\\"type\\\":\\\"function\\\"},{\\\"inputs\\\":[],\\\"name\\\":\\\"livenessWindow\\\",\\\"outputs\\\":[{\\\"internalType\\\":\\\"uint256\\\",\\\"name\\\":\\\"\\\",\\\"type\\\":\\\"uint256\\\"}],\\\"stateMutability\\\":\\\"view\\\",\\\"type\\\":\\\"function\\\"},{\\\"inputs\\\":[],\\\"name\\\":\\\"owner\\\",\\\"outputs\\\":[{\\\"internalType\\\":\\\"address\\\",\\\"name\\\":\\\"\\\",\\\"type\\\":\\\"address\\\"}],\\\"stateMutability\\\":\\\"view\\\",\\\"type\\\":\\\"function\\\"},{\\\"inputs\\\":[],\\\"name\\\":\\\"renounceOwnership\\\",\\\"outputs\\\":[],\\\"stateMutability\\\":\\\"pure\\\",\\\"type\\\":\\\"function\\\"},{\\\"inputs\\\":[{\\\"internalType\\\":\\\"uint256\\\",\\\"name\\\":\\\"newWindow\\\",\\\"type\\\":\\\"uint256\\\"}],\\\"name\\\":\\\"setLivenessWindow\\\",\\\"outputs\\\":[],\\\"stateMutability\\\":\\\"nonpayable\\\",\\\"type\\\":\\\"function\\\"},{\\\"inputs\\\":[{\\\"internalType\\\":\\\"address\\\",\\\"name\\\":\\\"newOwner\\\",\\\"type\\\":\\\"address\\\"}],\\\"name\\\":\\\"transferOwnership\\\",\\\"outputs\\\":[],\\\"stateMutability\\\":\\\"nonpayable\\\",\\\"type\\\":\\\"function\\\"},{\\\"inputs\\\":[],\\\"name\\\":\\\"version\\\",\\\"outputs\\\":[{\\\"internalType\\\":\\\"string\\\",\\\"name\\\":\\\"\\\",\\\"type\\\":\\\"string\\\"}],\\\"stateMutability\\\":\\\"pure\\\",\\\"type\\\":\\\"function\\\"}],\\\"devdoc\\\":{\\\"details\\\":\\\"UPGRADEABILITY DECISION \\\\u2014 NON-UPGRADEABLE, single instance (mirrors {PolicyRegistry}).      This is a peripheral, read-only-from-DVT oracle with zero SuperPaymaster-core coupling.      Immutability removes a proxy-admin key as an attack surface and keeps the storage layout      permanently auditable. It deliberately does NOT touch the SuperPaymaster `OperatorConfig`      struct (a hot, UUPS-storage-sensitive slot). If a future hard requirement appears (e.g. a      BLS-aggregated batch attest), deploy v2 and re-point DVT \\\\u2014 operators re-attest cheaply      (self-healing), so no state migration is needed.LIVENESS SEMANTIC (what \\\\\\\"live\\\\\\\" proves, and what it does NOT). {attestLiveness} proves the      operator's signing key produced a transaction within the last `MAX_ATTEST_ANCHOR_AGE` blocks      (enforced by the freshness binding \\\\u2014 the caller must echo a recent, unpredictable      `blockhash`, so the tx cannot be pre-signed for the future). This ties \\\\\\\"live\\\\\\\" to RECENT      signing capability, defeating a keeper that replays a batch of stale pre-authorized      attestations to keep an abandoned-key operator counted in the live-set (quorum denominator) \\\\u2014      a denominator-inflation vector that could otherwise suppress a legitimate slash against a      colluder (CC-29 review M-01). It does NOT prove the full DVT stack is online: an operator      whose key is genuinely online but which refuses to co-sign slashes still attests fine; that      residual griefer is caught at the DVT layer by excluding recent non-participants from quorum,      NOT here.OFFLINE AND SLASHING \\\\u2014 this contract carries NO slash, and that is a statement about      THIS contract, not about the protocol. Ops has since decided that sustained downtime      DOES cost the operator GToken, on a graduated scale: jail first, slash scaled to how      long the operator stayed down, and re-entry to the live-set on recovery. None of that      belongs here. This contract's job is to make \\\\\\\"offline\\\\\\\" an objective, cheap, on-chain      FACT \\\\u2014 `isOffline`/`lastLive` pinned to a finalized epoch block. Whoever prices that      fact (Registry / GTokenStaking) reads it; putting the penalty here would weld the      oracle to one penalty schedule and make every future tariff change an immutable-contract      redeploy. So read this paragraph as \\\\\\\"no slash is triggered FROM here\\\\\\\", not as \\\\\\\"downtime      is free\\\\\\\" \\\\u2014 the latter was true when this was written and is no longer the plan.GOVERNANCE \\\\u2014 the window IS the definition of offline, so changing {livenessWindow}      deterministically RE-PARTITIONS the live-set at the next block, in BOTH directions and with      immediate effect: shrinking can mass-exclude live operators (quorum collapse); expanding      revives long-idle operators into the live-set WITHOUT a fresh attestation. Both are intended      governance actions, not bugs \\\\u2014 which is exactly why the owner MUST be a TimelockController /      multisig (a sudden unilateral change is fleet-critical). {renounceOwnership} is disabled so      an adverse window can never be frozen in permanently; hand control over via {transferOwnership}.\\\",\\\"errors\\\":{\\\"OwnableInvalidOwner(address)\\\":[{\\\"details\\\":\\\"The owner is not a valid owner account. (eg. `address(0)`)\\\"}],\\\"OwnableUnauthorizedAccount(address)\\\":[{\\\"details\\\":\\\"The caller account is not authorized to perform an operation.\\\"}]},\\\"kind\\\":\\\"dev\\\",\\\"methods\\\":{\\\"attestLiveness(uint256,bytes32)\\\":{\\\"details\\\":\\\"FRESHNESS BINDING (M-01): the caller must echo the hash of a recent block. A blockhash is      unpredictable until its block exists, and `blockhash()` only exposes the last 256 blocks,      so a transaction CANNOT be pre-signed to cover a future period \\\\u2014 the signer must have      observed a block within the last `MAX_ATTEST_ANCHOR_AGE` blocks. This ties \\\\\\\"live\\\\\\\" to      recent signing capability and defeats a keeper replaying a batch of stale, pre-authorized      attestations to keep an abandoned-key operator in the live-set. (It does NOT, by itself,      stop an operator whose key is genuinely online but which refuses to co-sign slashes \\\\u2014 that      residual griefer is caught at the DVT layer by excluding recent non-participants.)      Still cheap: one `blockhash` read + one warm SSTORE. Permissionless; consumers decide which      addresses count. A v2 MAY add a BLS-aggregated batch form.\\\",\\\"params\\\":{\\\"anchorBlock\\\":\\\"a recent block in `[block.number - MAX_ATTEST_ANCHOR_AGE, block.number - 1]`.\\\",\\\"anchorHash\\\":\\\"must equal `blockhash(anchorBlock)`.\\\"}},\\\"constructor\\\":{\\\"params\\\":{\\\"governance\\\":\\\"owner authorized to change the window; SHOULD be a TimelockController /        multisig (shrinking the window is fleet-sensitive). Ownable reverts on the zero owner.\\\",\\\"initialWindow\\\":\\\"starting fleet-wide window in blocks; must be within bounds.\\\"}},\\\"isOffline(address)\\\":{\\\"details\\\":\\\"Uses `block.number` (the executing block) so an archival `eth_call` pinned to a finalized      epoch reproduces the exact live-set for that epoch. Written as `block.number - last` (NOT      `last + _livenessWindow`) so the arithmetic is overflow-proof for ALL inputs: `last <=      block.number` makes the subtraction safe, whereas `last + window` could in principle      overflow near `uint256.max`.\\\"},\\\"lastLive(address)\\\":{\\\"details\\\":\\\"Exposed for forensics / alerting (who went offline, from which block) and to make the      live-set denominator auditable. Not part of any slash content-address (no offline slash).\\\"},\\\"livenessWindow()\\\":{\\\"details\\\":\\\"Governance-set and identical for the whole DVT fleet (NOT per-community) so every      co-signer computes the same live-set; DVT reads it (pinned to the same epoch block).\\\"},\\\"owner()\\\":{\\\"details\\\":\\\"Returns the address of the current owner.\\\"},\\\"transferOwnership(address)\\\":{\\\"details\\\":\\\"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner.\\\"}},\\\"stateVariables\\\":{\\\"MAX_ATTEST_ANCHOR_AGE\\\":{\\\"details\\\":\\\"Fixed at the EVM's `blockhash` availability window (256). An attestation must anchor to a      block no older than this; older/current/future anchors have no readable `blockhash`.\\\"},\\\"MAX_LIVENESS_WINDOW\\\":{\\\"details\\\":\\\"~10M blocks: generous enough to effectively disable liveness on any chain if governance      chooses, while still bounding the field to an auditable magnitude.\\\"},\\\"MIN_LIVENESS_WINDOW\\\":{\\\"details\\\":\\\"100 blocks \\\\u2248 a few minutes on most chains; below this a single missed ping / RPC hiccup      could mass-jail the fleet.\\\"},\\\"_lastLive\\\":{\\\"details\\\":\\\"operator \\\\u21d2 block number of last attestation (0 = never attested).\\\"},\\\"_livenessWindow\\\":{\\\"details\\\":\\\"Fleet-wide window, in blocks. Read via {livenessWindow}.\\\"}},\\\"title\\\":\\\"LivenessRegistry \\\\u2014 objective on-chain operator liveness oracle (CC-29)\\\",\\\"version\\\":1},\\\"userdoc\\\":{\\\"errors\\\":{\\\"BadAnchorHash(uint256)\\\":[{\\\"notice\\\":\\\"`anchorHash` does not equal `blockhash(anchorBlock)` (or the anchor hash is unavailable).\\\"}],\\\"InvalidWindow(uint256)\\\":[{\\\"notice\\\":\\\"The proposed window is outside [MIN_LIVENESS_WINDOW, MAX_LIVENESS_WINDOW].\\\"}],\\\"RenounceDisabled()\\\":[{\\\"notice\\\":\\\"{renounceOwnership} is permanently disabled (see GOVERNANCE note).\\\"}],\\\"StaleAnchor(uint256)\\\":[{\\\"notice\\\":\\\"The freshness anchor is not in `[block.number - MAX_ATTEST_ANCHOR_AGE, block.number-1]`.\\\"}]},\\\"events\\\":{\\\"LivenessAttested(address,uint256)\\\":{\\\"notice\\\":\\\"Emitted whenever an operator proves liveness. `atBlock` == the recorded lastLive.\\\"},\\\"LivenessWindowUpdated(uint256,uint256)\\\":{\\\"notice\\\":\\\"Emitted when governance changes the fleet-wide liveness window (in blocks).\\\"}},\\\"kind\\\":\\\"user\\\",\\\"methods\\\":{\\\"MAX_ATTEST_ANCHOR_AGE()\\\":{\\\"notice\\\":\\\"Max age (in blocks) of the freshness anchor {attestLiveness} may reference. Bounded by         the EVM's 256-block `blockhash` window.\\\"},\\\"MAX_LIVENESS_WINDOW()\\\":{\\\"notice\\\":\\\"Upper bound on {livenessWindow} \\\\u2014 fat-finger guard against an absurd value.\\\"},\\\"MIN_LIVENESS_WINDOW()\\\":{\\\"notice\\\":\\\"Lower bound on {livenessWindow} \\\\u2014 blocks a value so small a single missed ping would         mass-jail the fleet.\\\"},\\\"areOffline(address[])\\\":{\\\"notice\\\":\\\"Batch form of {isOffline} \\\\u2014 one call to build a full live-set denominator.\\\"},\\\"attestLiveness(uint256,bytes32)\\\":{\\\"notice\\\":\\\"Prove the caller is live *now*. Records `lastLive[msg.sender] = block.number`.\\\"},\\\"isOffline(address)\\\":{\\\"notice\\\":\\\"True iff `operator` is offline as of the block this call executes against.\\\"},\\\"lastLive(address)\\\":{\\\"notice\\\":\\\"Block number of `operator`'s most recent attestation (0 = never attested).\\\"},\\\"livenessWindow()\\\":{\\\"notice\\\":\\\"Fleet-wide liveness window, in blocks. offline \\\\u21d4 `blockNumber \\\\u2212 lastLive > window`.\\\"},\\\"renounceOwnership()\\\":{\\\"notice\\\":\\\"Disabled: renouncing ownership would freeze {livenessWindow} at its current value         forever, permanently locking the live-set partition \\\\u2014 a governance footgun. Transfer         to a new timelock / multisig via {transferOwnership} instead. Always reverts.\\\"},\\\"setLivenessWindow(uint256)\\\":{\\\"notice\\\":\\\"Set the fleet-wide liveness window (blocks). Owner-only; owner SHOULD be a         TimelockController / multisig because SHRINKING the window is fleet-sensitive         (a sudden shrink can flip many operators to offline at once). Bounded to         [MIN_LIVENESS_WINDOW, MAX_LIVENESS_WINDOW] as a fat-finger guard.\\\"},\\\"version()\\\":{\\\"notice\\\":\\\"Contract version (see CLAUDE.md versioning convention).\\\"}},\\\"notice\\\":\\\"Reference implementation of {ILivenessRegistry}. Operators self-attest; DVT reads the         resulting {isOffline}/{lastLive} (pinned to a finalized epoch block) to compute the         live-set / quorum denominator for the real malicious-slash paths. Offline is never         slashed by consensus \\\\u2014 it auto-jails by exclusion (see the interface for the full model).\\\",\\\"version\\\":1}},\\\"settings\\\":{\\\"compilationTarget\\\":{\\\"contracts/src/core/LivenessRegistry.sol\\\":\\\"LivenessRegistry\\\"},\\\"evmVersion\\\":\\\"cancun\\\",\\\"libraries\\\":{},\\\"metadata\\\":{\\\"bytecodeHash\\\":\\\"none\\\"},\\\"optimizer\\\":{\\\"enabled\\\":true,\\\"runs\\\":500},\\\"remappings\\\":[\\\":@account-abstraction-v7/=singleton-paymaster/lib/account-abstraction-v7/contracts/\\\",\\\":@chainlink/contracts/=contracts/lib/chainlink-brownie-contracts/contracts/\\\",\\\":@openzeppelin-v5.0.2/=singleton-paymaster/lib/openzeppelin-contracts-v5.0.2/\\\",\\\":@openzeppelin/contracts/=singleton-paymaster/lib/openzeppelin-contracts-v5.0.2/contracts/\\\",\\\":account-abstraction-v6/=singleton-paymaster/lib/account-abstraction-v6/contracts/\\\",\\\":account-abstraction-v7/=singleton-paymaster/lib/account-abstraction-v7/contracts/\\\",\\\":account-abstraction-v8/=singleton-paymaster/lib/account-abstraction-v8/contracts/\\\",\\\":chainlink-brownie-contracts/=contracts/lib/chainlink-brownie-contracts/contracts/src/v0.6/vendor/@arbitrum/nitro-contracts/src/\\\",\\\":ds-test/=singleton-paymaster/lib/openzeppelin-contracts-v5.0.2/lib/forge-std/lib/ds-test/src/\\\",\\\":erc4626-tests/=singleton-paymaster/lib/openzeppelin-contracts-v5.0.2/lib/erc4626-tests/\\\",\\\":forge-std/=contracts/lib/forge-std/src/\\\",\\\":halmos-cheatcodes/=singleton-paymaster/lib/openzeppelin-contracts-v5.1.0/lib/halmos-cheatcodes/src/\\\",\\\":openzeppelin-contracts-v4.8.3/=singleton-paymaster/lib/openzeppelin-contracts-v4.8.3/\\\",\\\":openzeppelin-contracts-v5.0.2/=singleton-paymaster/lib/openzeppelin-contracts-v5.0.2/\\\",\\\":openzeppelin-contracts-v5.1.0/=singleton-paymaster/lib/openzeppelin-contracts-v5.1.0/\\\",\\\":singleton-paymaster/=singleton-paymaster/\\\",\\\":solady/=contracts/lib/solady/src/\\\",\\\":src/=contracts/src/\\\"],\\\"viaIR\\\":true},\\\"sources\\\":{\\\"contracts/src/core/LivenessRegistry.sol\\\":{\\\"keccak256\\\":\\\"0x42dd06d3159b88fa3eb86335ab906bf460d7e33940b696549fe3a2a315556656\\\",\\\"license\\\":\\\"Apache-2.0\\\",\\\"urls\\\":[\\\"bzz-raw://6cf02d44e2a45377b1643480c94f68b8d15e1747e9ebf9e79d1ea8a1d7d6ab81\\\",\\\"dweb:/ipfs/QmQsYtyTkmTsybgcbQhbb6H5BnRE8XbbFUNd7H4LBSXQQ7\\\"]},\\\"contracts/src/interfaces/v3/ILivenessRegistry.sol\\\":{\\\"keccak256\\\":\\\"0xc4d3863693f15d331f88d0edcefc06016dcb4c1824ba18e5df6429be3a8073ca\\\",\\\"license\\\":\\\"Apache-2.0\\\",\\\"urls\\\":[\\\"bzz-raw://abf304cf1e9e80cc05e79dd4349bf3bb502197e42466253e9389057876946f3a\\\",\\\"dweb:/ipfs/Qme8utxAvDZ8VKU46PaBgFSzahBowSZ7HfnUFxjhvGHKCR\\\"]},\\\"singleton-paymaster/lib/openzeppelin-contracts-v5.0.2/contracts/access/Ownable.sol\\\":{\\\"keccak256\\\":\\\"0xff6d0bb2e285473e5311d9d3caacb525ae3538a80758c10649a4d61029b017bb\\\",\\\"license\\\":\\\"MIT\\\",\\\"urls\\\":[\\\"bzz-raw://8ed324d3920bb545059d66ab97d43e43ee85fd3bd52e03e401f020afb0b120f6\\\",\\\"dweb:/ipfs/QmfEckWLmZkDDcoWrkEvMWhms66xwTLff9DDhegYpvHo1a\\\"]},\\\"singleton-paymaster/lib/openzeppelin-