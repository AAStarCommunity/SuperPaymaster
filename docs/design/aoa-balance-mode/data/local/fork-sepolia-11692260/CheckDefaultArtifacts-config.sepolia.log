\\":\\\"\\\",\\\"type\\\":\\\"string\\\"}],\\\"stateMutability\\\":\\\"pure\\\",\\\"type\\\":\\\"function\\\"},{\\\"inputs\\\":[{\\\"internalType\\\":\\\"bytes32\\\",\\\"name\\\":\\\"channelId\\\",\\\"type\\\":\\\"bytes32\\\"}],\\\"name\\\":\\\"withdrawChannel\\\",\\\"outputs\\\":[],\\\"stateMutability\\\":\\\"nonpayable\\\",\\\"type\\\":\\\"function\\\"}],\\\"devdoc\\\":{\\\"details\\\":\\\"Key design decisions:      - Cumulative voucher pattern: each voucher states the *total* amount owed,        so natural replay protection is achieved without nonces.      - authorizedSigner delegation allows AirAccount Session Keys to sign        vouchers on behalf of the payer.      - channelId is bound to (contract address, chainId) to prevent        cross-chain and cross-contract replay attacks.      - closeTimeout gives the payee a window to submit final vouchers        before the payer can unilaterally withdraw remaining funds.\\\",\\\"errors\\\":{\\\"AddressEmptyCode(address)\\\":[{\\\"details\\\":\\\"There's no code at `target` (it is not a contract).\\\"}],\\\"AddressInsufficientBalance(address)\\\":[{\\\"details\\\":\\\"The ETH balance of the account is not enough to perform the operation.\\\"}],\\\"FailedInnerCall()\\\":[{\\\"details\\\":\\\"A call to an address target failed. The target may have reverted.\\\"}],\\\"OwnableInvalidOwner(address)\\\":[{\\\"details\\\":\\\"The owner is not a valid owner account. (eg. `address(0)`)\\\"}],\\\"OwnableUnauthorizedAccount(address)\\\":[{\\\"details\\\":\\\"The caller account is not authorized to perform an operation.\\\"}],\\\"ReentrancyGuardReentrantCall()\\\":[{\\\"details\\\":\\\"Unauthorized reentrant call.\\\"}],\\\"SafeERC20FailedOperation(address)\\\":[{\\\"details\\\":\\\"An operation with an ERC20 token failed.\\\"}]},\\\"kind\\\":\\\"dev\\\",\\\"methods\\\":{\\\"closeChannel(bytes32,uint128,bytes)\\\":{\\\"details\\\":\\\"Only the payee can call. Finalizes the channel.\\\",\\\"params\\\":{\\\"channelId\\\":\\\"Channel identifier.\\\",\\\"cumulativeAmount\\\":\\\"Final cumulative amount owed.\\\",\\\"signature\\\":\\\"EIP-712 voucher signature for the final amount.\\\"}},\\\"eip712Domain()\\\":{\\\"details\\\":\\\"See: https://eips.ethereum.org/EIPS/eip-5267\\\"},\\\"getChannel(bytes32)\\\":{\\\"params\\\":{\\\"channelId\\\":\\\"Channel identifier.\\\"},\\\"returns\\\":{\\\"_0\\\":\\\"channel  The Channel struct.\\\"}},\\\"openChannel(address,address,uint128,bytes32,address)\\\":{\\\"params\\\":{\\\"authorizedSigner\\\":\\\"Delegated signer (e.g. AirAccount Session Key).                          Set to address(0) to require payer's own signature.\\\",\\\"deposit\\\":\\\"Initial deposit amount (transferred from msg.sender).\\\",\\\"payee\\\":\\\"Recipient of payments (service provider).\\\",\\\"salt\\\":\\\"User-provided salt for channelId uniqueness.\\\",\\\"token\\\":\\\"ERC-20 token used for payments.\\\"},\\\"returns\\\":{\\\"channelId\\\":\\\"Deterministic identifier for this channel.\\\"}},\\\"owner()\\\":{\\\"details\\\":\\\"Returns the address of the current owner.\\\"},\\\"renounceOwnership()\\\":{\\\"details\\\":\\\"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner.\\\"},\\\"requestCloseChannel(bytes32)\\\":{\\\"details\\\":\\\"Only the payer can call. The payee has closeTimeout seconds      to submit any remaining vouchers before the payer can withdraw.\\\",\\\"params\\\":{\\\"channelId\\\":\\\"Channel identifier.\\\"}},\\\"setCloseTimeout(uint64)\\\":{\\\"details\\\":\\\"Only the owner can call. The new value must be within      [MIN_CLOSE_TIMEOUT, MAX_CLOSE_TIMEOUT].\\\",\\\"params\\\":{\\\"_timeout\\\":\\\"New timeout in seconds.\\\"}},\\\"settleChannel(bytes32,uint128,bytes)\\\":{\\\"details\\\":\\\"Only the payee can call. The voucher must be signed by the payer      or the channel's authorizedSigner.\\\",\\\"params\\\":{\\\"channelId\\\":\\\"Channel identifier.\\\",\\\"cumulativeAmount\\\":\\\"Total cumulative amount owed (must exceed previous settled).\\\",\\\"signature\\\":\\\"EIP-712 voucher signature.\\\"}},\\\"topUpChannel(bytes32,uint128)\\\":{\\\"details\\\":\\\"Only the payer can call.\\\",\\\"params\\\":{\\\"amount\\\":\\\"Additional deposit amount.\\\",\\\"channelId\\\":\\\"Channel identifier.\\\"}},\\\"transferOwnership(address)\\\":{\\\"details\\\":\\\"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner.\\\"},\\\"version()\\\":{\\\"returns\\\":{\\\"_0\\\":\\\"Version identifier.\\\"}},\\\"withdrawChannel(bytes32)\\\":{\\\"details\\\":\\\"Only the payer can call. Requires that a close was requested and      the timeout has elapsed.\\\",\\\"params\\\":{\\\"channelId\\\":\\\"Channel identifier.\\\"}}},\\\"stateVariables\\\":{\\\"VOUCHER_TYPEHASH\\\":{\\\"details\\\":\\\"EIP-712 type hash for voucher signatures.\\\"},\\\"_channels\\\":{\\\"details\\\":\\\"channelId => Channel\\\"},\\\"closedChannels\\\":{\\\"details\\\":\\\"Tracks channelIds that have been finalized. Persists after struct deletion      to block voucher replay via same-salt channel reopening (B4-N5 fix).\\\"}},\\\"title\\\":\\\"MicroPaymentChannel\\\",\\\"version\\\":1},\\\"userdoc\\\":{\\\"kind\\\":\\\"user\\\",\\\"methods\\\":{\\\"MAX_CLOSE_TIMEOUT()\\\":{\\\"notice\\\":\\\"Maximum allowed closeTimeout (24 hours).\\\"},\\\"MIN_CLOSE_TIMEOUT()\\\":{\\\"notice\\\":\\\"Minimum allowed closeTimeout (5 minutes).\\\"},\\\"closeChannel(bytes32,uint128,bytes)\\\":{\\\"notice\\\":\\\"Cooperatively close a channel. Payee submits final voucher,         receives settled amount, and payer gets the refund.\\\"},\\\"closeTimeout()\\\":{\\\"notice\\\":\\\"Dispute window (in seconds) after a close request before the payer can withdraw.         Owner-configurable between MIN_CLOSE_TIMEOUT and M