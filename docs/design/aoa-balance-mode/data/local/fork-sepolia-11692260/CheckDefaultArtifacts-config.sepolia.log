e\":\"function\",\"name\":\"setIndustryMultiplier\"},{\"inputs\":[{\"internalType\":\"string\",\"name\":\"category\",\"type\":\"string\"},{\"internalType\":\"uint256\",\"name\":\"scaleUSD\",\"type\":\"uint256\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\",\"name\":\"setIndustryScaleUSD\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"_superPaymaster\",\"type\":\"address\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\",\"name\":\"setSuperPaymasterAddress\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"internalType\":\"string\",\"name\":\"category\",\"type\":\"string\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\",\"name\":\"setTokenCategory\"},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}],\"stateMutability\":\"view\",\"type\":\"function\",\"name\":\"tokenCategory\",\"outputs\":[{\"internalType\":\"string\",\"name\":\"\",\"type\":\"string\"}]},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"newOwner\",\"type\":\"address\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\",\"name\":\"transferOwnership\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"newPrice\",\"type\":\"uint256\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\",\"name\":\"updateAPNTsPrice\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"avgDailyTx\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"avgGasCost\",\"type\":\"uint256\"},{\"internalType\":\"string\",\"name\":\"industry\",\"type\":\"string\"},{\"internalType\":\"uint256\",\"name\":\"safetyFactor\",\"type\":\"uint256\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\",\"name\":\"updatePrediction\"},{\"inputs\":[{\"internalType\":\"uint256\",\"name\":\"avgDailyTx\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"avgGasCost\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"customMultiplier\",\"type\":\"uint256\"},{\"internalType\":\"uint256\",\"name\":\"safetyFactor\",\"type\":\"uint256\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\",\"name\":\"updatePredictionCustom\"},{\"inputs\":[],\"stateMutability\":\"pure\",\"type\":\"function\",\"name\":\"version\",\"outputs\":[{\"internalType\":\"string\",\"name\":\"\",\"type\":\"string\"}]}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{\"constructor\":{\"params\":{\"_registry\":\"Registry contract address\",\"_superPaymaster\":\"SuperPaymaster v2.0 address\"}},\"deployxPNTsToken(string,string,string,string,uint256,address)\":{\"params\":{\"communityENS\":\"Community ENS domain\",\"communityName\":\"Community display name\",\"exchangeRate\":\"Exchange rate with aPNTs (18 decimals, e.g., 1e18 = 1:1)\",\"name\":\"Token name (e.g., \\\"MyDAO Points\\\")\",\"paymasterAOA\":\"Paymaster address for AOA mode (optional, use address(0) for AOA+ only)\",\"symbol\":\"Token symbol (e.g., \\\"xMDAO\\\")\"},\"returns\":{\"token\":\"Deployed token address\"}},\"getAPNTsPrice()\":{\"details\":\"Used by PaymasterV4 and SuperPaymaster V2 for gas cost calculation\",\"returns\":{\"price\":\"aPNTs price in USD (18 decimals)\"}},\"getAllTokens()\":{\"returns\":{\"tokens\":\"Array of token addresses\"}},\"getDeployedCount()\":{\"returns\":{\"count\":\"Total count\"}},\"getDepositBreakdown(address)\":{\"params\":{\"community\":\"Community address\"},\"returns\":{\"dailyCost\":\"Daily cost estimate\",\"monthlyCost\":\"Monthly cost estimate\",\"multiplierUsed\":\"Industry multiplier used\",\"safetyFactorUsed\":\"Safety factor used\",\"suggestedAmount\":\"Suggested deposit with safety factor\"}},\"getIndustryMultiplier(string)\":{\"params\":{\"industry\":\"Industry name\"},\"returns\":{\"multiplier\":\"Multiplier value (scaled by 1e18)\"}},\"getPredictionParams(address)\":{\"params\":{\"community\":\"Community address\"},\"returns\":{\"params\":\"Prediction parameters\"}},\"getTokenAddress(address)\":{\"params\":{\"community\":\"Community address\"},\"returns\":{\"token\":\"Token address (address(0) if not deployed)\"}},\"hasToken(address)\":{\"params\":{\"community\":\"Community address\"},\"returns\":{\"_0\":\"hasToken True if token deployed\"}},\"owner()\":{\"details\":\"Returns the address of the current owner.\"},\"predictDepositAmount(address)\":{\"params\":{\"community\":\"Community address\"},\"returns\":{\"suggestedAmount\":\"Suggested deposit amount in aPNTs\"}},\"propagateSuperPaymaster(uint256,uint256)\":{\"details\":\"Best-effort: failures emit SuperPaymasterPropagationFailed without reverting.      Call repeatedly with increasing `start` to handle large deployedTokens arrays      and to retry previously failed tokens.\",\"params\":{\"limit\":\"Maximum number of tokens to process in this call.\",\"start\":\"Index in deployedTokens to start from (inclusive).\"}},\"renounceOwnership()\":{\"details\":\"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner.\"},\"setIndustryMultiplier(string,uint256)\":{\"params\":{\"industry\":\"Industry name\",\"multiplier\":\"Multiplier value (scaled by 1e18)\"}},\"setIndustryScaleUSD(string,uint256)\":{\"details\":\"0 is allowed — it means the category has no baseline credit and communities in         it must back all issuance with staked aPNTs. Governance-controlled.\"},\"setSuperPaymasterAddress(address)\":{\"details\":\"M-8: stores new SP address only; use propagateSuperPaymaster() to push to deployed tokens (OOG-safe batched approach).\"},\"setTokenCategory(address,string)\":{\"details\":\"L-1: the token must be one this factory deployed (isXPNTs), so a typo'd address         can't seed junk state. L-2: a non-empty category must already be REGISTERED (via         setIndustryScaleUSD or constructor), so a governance typo can't silently assign an         unknown zero-baseline category that forces 100% stake coverage. A deliberate         zero-baseline category is still assignable — register it with setIndustryScaleUSD         (any value, including 0). Pass \\\"\\\" to use the default baseline.\"},\"transferOwnership(address)\":{\"details\":\"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner.\"},\"updateAPNTsPrice(uint256)\":{\"details\":\"Price is updated off-chain periodically for dynamic pricing.P0-12: absolute bounds + 30% per-tx delta to prevent price manipulation.EXECUTION CHECKLIST — this number leaves the repo. `aPNTsPriceUSD` is the      denominator for anything that prices aPNTs in dollars, and at least one such      consumer bakes the result into storage it can never loosen again:      repo:airaccount's account guard fixes per-tier transfer limits in absolute      aPNTs at `initialize`, and `tier1Limit`/`tier2Limit` are then permanently      unchangeable (`addTokenConfig` reverts on an already-configured token);      `dailyLimit` can only be lowered. Raising the price therefore RELAXES a guard      that cannot be tightened back, on accounts that already exist.      The bounds here do not protect that: `APNTS_PRICE_MAX` is 100 ether, five      thousand times the $0.02 the token launches at, and the ±30% delta only makes      the walk take steps rather than preventing it.      So before calling this, check the new price against the limits already baked      by every downstream consumer, and tell them before it lands. Neither side's      tests can see this: the change happens here and the consequence lands in      their immutable storage, and nothing on either side reads the other.\",\"params\":{\"newPrice\":\"New price in USD (18 decimals, e.g., 0.02e18 = $0.02)\"}},\"updatePrediction(uint256,uint256,string,uint256)\":{\"params\":{\"avgDailyTx\":\"Average daily transactions\",\"avgGasCost\":\"Average gas cost in wei\",\"industry\":\"Industry type (e.g., \\\"DeFi\\\", \\\"Gaming\\\")\",\"safetyFactor\":\"Safety factor (scaled by 1e18, default 1.5e18)\"}},\"updatePredictionCustom(uint256,uint256,uint256,uint256)\":{\"params\":{\"avgDailyTx\":\"Average daily transactions\",\"avgGasCost\":\"Average gas cost in wei\",\"customMultiplier\":\"Custom industry multiplier (scaled by 1e18)\",\"safetyFactor\":\"Safety factor (scaled by 1e18)\"}},\"version()\":{\"returns\":{\"_0\":\"versionString The version string (e.g., \\\"v3.1.0\\\")\"}}},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"DEFAULT_SAFETY_FACTOR()\":{\"notice\":\"Default safety factor: 1.5x (50% buffer)\"},\"MAX_INDUSTRY_SCALE_USD()\":{\"notice\":\"CC-28: safety ceiling on a category's baseline (guards effectiveCapUSD overflow).\"},\"MIN_SUGGESTED_AMOUNT()\":{\"notice\":\"Minimum suggested amount: 100 aPNTs\"},\"REGISTRY()\":{\"notice\":\"Registry contract address\"},\"SUPERPAYMASTER()\":{\"notice\":\"SuperPaymaster contract address\"},\"aPNTsPriceUSD()\":{\"notice\":\"aPNTs USD price (18 decimals, e.g., 0.02e18 = $0.02)\"},\"capRatioBps()\":{\"notice\":\"CC-28: fraction of industryScaleUSD granted as the baseline cap, in basis points.\"},\"categoryRegistered(string)\":{\"notice\":\"CC-28: whether a category key has been governance-registered (via         setIndustryScaleUSD or constructor seeding). Distinguishes a DELIBERATE         zero-baseline category (registered, scale 0 → full stake-backing required)         from a typo'd category name (never registered) in setTokenCategory.\"},\"communityToToken(address)\":{\"notice\":\"Mapping: community address => xPNTs token address\"},\"constructor\":{\"notice\":\"Initialize factory\"},\"deployedTokens(uint256)\":{\"notice\":\"List of all deployed tokens\"},\"deployxPNTsToken(string,string,string,string,uint256,address)\":{\"notice\":\"Deploy new xPNTs token\"},\"getAPNTsPrice()\":{\"notice\":\"Get current aPNTs USD price\"},\"getAllTokens()\":{\"notice\":\"Get all deployed tokens\"},\"getDeployedCount()\":{\"notice\":\"Get total deployed tokens count\"},\"getDepositBreakdown(address)\":{\"notice\":\"Calculate deposit breakdown\"},\"getIndustryMultiplier(string)\":{\"notice\":\"Get industry multiplier\"},\"getPredictionParams(address)\":{\"notice\":\"Get prediction parameters for community\"},\"getTokenAddress(address)\":{\"notice\":\"Get xPNTs token address for community\"},\"hasToken(address)\":{\"notice\":\"Check if community has deployed token\"},\"implementation()\":{\"notice\":\"The address of the xPNTsToken implementation contract used for cloning.\"},\"industryMultipliers(string)\":{\"notice\":\"Industry multipliers (name => value in 1e18)\"},\"industryScaleUSD(string)\":{\"notice\":\"CC-28 over-issue model: baseline issuance ceiling per industry category         (USD, 18 decimals). The non-staked credit floor a category is trusted with.         Governance-set. 0 => the category has no baseline (a community in it must back         its issuance entirely with staked aPNTs). Read by xPNTsToken.effectiveCapUSD().\"},\"isXPNTs(address)\":{\"notice\":\"Whitelist of tokens this factory has deployed.\"},\"predictDepositAmount(address)\":{\"notice\":\"AI-powered deposit amount prediction\"},\"predictions(address)\":{\"notice\":\"Mapping: community address => prediction parameters\"},\"propagateSuperPaymaster(uint256,uint256)\":{\"notice\":\"Propagate current SUPERPAYMASTER address to a batch of deployed tokens.\"},\"setCapRatioBps(uint16)\":{\"notice\":\"CC-28: set the global baseline cap ratio in basis points (0 < bps <= 10000).\"},\"setIndustryMultiplier(string,uint256)\":{\"notice\":\"Set industry multiplier (only owner)\"},\"setIndustryScaleUSD(string,uint256)\":{\"notice\":\"CC-28: set the baseline issuance ceiling (USD, 18 decimals) for a category.\"},\"setTokenCategory(address,string)\":{\"notice\":\"CC-28: assign the industry category for an xPNTs token. Governance-only so the         audited community cannot self-select a higher-baseline category to evade         over-issue detection. Empty string resets the token to the \\\"default\\\" baseline.\"},\"tokenCategory(address)\":{\"notice\":\"CC-28: governance-assigned industry category per xPNTs token.\"},\"updateAPNTsPrice(uint256)\":{\"notice\":\"Update aPNTs USD price (only owner)\"},\"updatePrediction(uint256,uint256,string,uint256)\":{\"notice\":\"Update prediction parameters\"},\"updatePredictionCustom(uint256,uint256,uint256,uint256)\":{\"notice\":\"Update prediction with custom multiplier\"},\"version()\":{\"notice\":\"Get human-readable version string\"}},\"version\":1}},\"settings\":{\"remappings\":[\"@account-abstraction-v7/=singleton-paymaster/lib/account-abstraction-v7/contracts/\",\"@chainlink/contracts/=contracts/lib/chainlink-brownie-contracts/contracts/\",\"@openzeppelin-v5.0.2/=singleton-paymaster/lib/openzeppelin-contracts-v5.0.2/\",\"@openzeppelin/contracts/=singleton-paymaster/lib/openzeppelin-contracts-v5.0.2/contracts/\",\"account-abstraction-v6/=singleton-paymaster/lib/account-abstraction-v6/contracts/\",\"account-abstraction-v7/=singleton-paymaster/lib/account-abstraction-v7/contracts/\",\"account-abstraction-v8/=singleton-paymaster/lib/account-abstraction-v8/contracts/\",\"chainlink-brownie-contracts/=contracts/lib/chainlink-brownie-contracts/contracts/src/v0.6/vendor/@arbitrum/nitro-contracts/src/\",\"ds-test/=singleton-paymaster/lib/openzeppelin-contracts-v5.0.2/lib/forge-std/lib/ds-test/src/\",\"erc4626-tests/=singleton-paymaster/lib/openzeppelin-contracts-v5.0.2/lib/erc4626-tests/\",\"forge-std/=contracts/lib/forge-std/src/\",\"halmos-cheatcodes/=singleton-paymaster/lib/openzeppelin-contracts-v5.1.0/lib/halmos-cheatcodes/src/\",\"openzeppelin-contracts-v4.8.3/=singleton-paymaster/lib/openzeppelin-contracts-v4.8.3/\",\"openzeppelin-contracts-v5.0.2/=singleton-paymaster/lib/openzeppelin-contracts-v5.0.2/\",\"openzeppelin-contracts-v5.1.0/=singleton-paymaster/lib/openzeppelin-contracts-v5.1.0/\",\"singleton-paymaster/=singleton-paymaster/\",\"solady/=contr