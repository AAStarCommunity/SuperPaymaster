\"inputs\":[],\"stateMutability\":\"view\",\"type\":\"function\",\"name\":\"treasury\",\"outputs\":[{\"internalType\":\"address\",\"name\":\"\",\"type\":\"address\"}]},{\"inputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\",\"name\":\"unlockStake\"},{\"inputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\",\"name\":\"unpause\"},{\"inputs\":[],\"stateMutability\":\"nonpayable\",\"type\":\"function\",\"name\":\"updatePrice\"},{\"inputs\":[{\"internalType\":\"struct PackedUserOperation\",\"name\":\"userOp\",\"type\":\"tuple\",\"components\":[{\"internalType\":\"address\",\"name\":\"sender\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"nonce\",\"type\":\"uint256\"},{\"internalType\":\"bytes\",\"name\":\"initCode\",\"type\":\"bytes\"},{\"internalType\":\"bytes\",\"name\":\"callData\",\"type\":\"bytes\"},{\"internalType\":\"bytes32\",\"name\":\"accountGasLimits\",\"type\":\"bytes32\"},{\"internalType\":\"uint256\",\"name\":\"preVerificationGas\",\"type\":\"uint256\"},{\"internalType\":\"bytes32\",\"name\":\"gasFees\",\"type\":\"bytes32\"},{\"internalType\":\"bytes\",\"name\":\"paymasterAndData\",\"type\":\"bytes\"},{\"internalType\":\"bytes\",\"name\":\"signature\",\"type\":\"bytes\"}]},{\"internalType\":\"bytes32\",\"name\":\"\",\"type\":\"bytes32\"},{\"internalType\":\"uint256\",\"name\":\"maxCost\",\"type\":\"uint256\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\",\"name\":\"validatePaymasterUserOp\",\"outputs\":[{\"internalType\":\"bytes\",\"name\":\"context\",\"type\":\"bytes\"},{\"internalType\":\"uint256\",\"name\":\"validationData\",\"type\":\"uint256\"}]},{\"inputs\":[],\"stateMutability\":\"pure\",\"type\":\"function\",\"name\":\"version\",\"outputs\":[{\"internalType\":\"string\",\"name\":\"\",\"type\":\"string\"}]},{\"inputs\":[{\"internalType\":\"address\",\"name\":\"token\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\",\"name\":\"withdraw\"},{\"inputs\":[{\"internalType\":\"address payable\",\"name\":\"withdrawAddress\",\"type\":\"address\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\",\"name\":\"withdrawStake\"},{\"inputs\":[{\"internalType\":\"address payable\",\"name\":\"withdrawAddress\",\"type\":\"address\"},{\"internalType\":\"uint256\",\"name\":\"amount\",\"type\":\"uint256\"}],\"stateMutability\":\"nonpayable\",\"type\":\"function\",\"name\":\"withdrawTo\"},{\"inputs\":[],\"stateMutability\":\"payable\",\"type\":\"receive\"}],\"devdoc\":{\"kind\":\"dev\",\"methods\":{\"activateInRegistry()\":{\"details\":\"Sets paused=false so validatePaymasterUserOp accepts new UserOps         again and isActiveInRegistry() returns true (assuming the owner         still holds ROLE_PAYMASTER_AOA in Registry).\"},\"constructor\":{\"details\":\"⚠\u{fe0f} This is the implementation contract for EIP-1167 minimal proxies❌ DO NOT deploy this contract directly - use PaymasterFactory instead!All configuration parameters must be set via initialize() after proxy deployment\",\"params\":{\"_registry\":\"SuperPaymaster Registry address (immutable, set at deployment)\"}},\"deactivateFromRegistry()\":{\"details\":\"\\\"deactivate\\\" is a listing notification, NOT an exitRole.         ROLE_PAYMASTER_AOA stays on the operator EOA throughout so the         operator can re-activate later with activateInRegistry().         Pausing the contract is the authoritative \\\"not accepting UserOps\\\"         signal; discovery consumers check !paused AND hasRole(owner).\"},\"getSupportedTokensInfo()\":{\"returns\":{\"decimalsArr\":\"Array of token decimals\",\"prices\":\"Array of USD prices (8 decimals)\",\"tokens\":\"Array of token addresses\"}},\"initialize(address,address,address,address,uint256,uint256,uint256)\":{\"params\":{\"_entryPoint\":\"EntryPoint contract address\",\"_ethUsdPriceFeed\":\"Chainlink ETH/USD price feed address\",\"_maxGasCostCap\":\"Maximum gas cost cap\",\"_owner\":\"Initial owner address\",\"_priceStalenessThreshold\":\"Staleness threshold\",\"_serviceFeeRate\":\"Service fee in basis points\",\"_treasury\":\"Treasury address for fee collection\"}},\"isActiveInRegistry()\":{\"details\":\"Two conditions must both hold:           1. The operator EOA (owner()) still holds ROLE_PAYMASTER_AOA.           2. The paymaster has not been deactivated (paused == false).         ROLE_PAYMASTER_AOA is on the operator EOA, NOT on address(this) —         querying address(this) (the old bug) always returned false.\"},\"isRegistrySet()\":{\"returns\":{\"_0\":\"True if registry address is configured\"}},\"owner()\":{\"details\":\"Returns the address of the current owner.\"},\"pause()\":{\"details\":\"The original code shipped `paused`, `whenNotPaused`, and the         Paused/Unpaused events, but no setter — the modifier could         never become true, leaving operators with no on-chain stop.         Combined with P0-5 (Registry exitRole) this gives V4 paymasters         a fast local halt and a coordinated registry-level deactivation.\"},\"postOp(uint8,bytes,uint256,uint256)\":{\"details\":\"Intentionally NOT guarded by whenNotPaused — UserOps that already      passed validatePaymasterUserOp must be allowed to settle; blocking      postOp would strand the EntryPoint and waste the bundler's gas.      Pause semantics: no new ops (validate blocked) + no withdrawals;      existing in-flight ops complete normally.\"},\"removeToken(address)\":{\"params\":{\"token\":\"ERC20 token address to remove\"}},\"renounceOwnership()\":{\"details\":\"Leaves the contract without owner. It will not be possible to call `onlyOwner` functions. Can only be called by the current owner. NOTE: Renouncing ownership will leave the contract without an owner, thereby disabling any functionality that is only available to the owner.\"},\"setCachedPrice(uint256,uint48)\":{\"details\":\"P0-16 (Codex B-N1): reject future timestamps. A future `updatedAt`      bypasses staleness checks and underflows the postOp staleness      subtraction in `_postOp`, bricking that path until the cache is      overwritten with a valid (past) timestamp.      A 15-second grace window (TIMESTAMP_GRACE_SECONDS) accommodates the      ~12 s maximum drift between a keeper's wall-clock and block.timestamp,      preventing spurious rejections of honest keepers.P0-11 (B2-N3 / V4): three guards stack on top of the P0-16      future-timestamp check:      - absolute MIN/MAX: prevent $0 / typo / crash-to-zero attacks      - ±30% per-tx delta (vs current cache): limits blast of a        misclick or partially-compromised owner key; skipped when        cachedPrice is uninitialised (first push).\",\"params\":{\"price\":\"ETH/USD price (8 decimals)\",\"timestamp\":\"Timestamp of the price\"}},\"setTokenPrice(address,uint256)\":{\"params\":{\"price\":\"USD price with 8 decimals (e.g. 1e8 = $1.00)\",\"token\":\"ERC20 token address\"}},\"transferOwnership(address)\":{\"details\":\"Transfers ownership of the contract to a new account (`newOwner`). Can only be called by the current owner.\"},\"validatePaymasterUserOp((address,uint256,bytes,bytes,bytes32,uint256,bytes32,bytes,bytes),bytes32,uint256)\":{\"details\":\"Deposit-Only mode: Checks internal balance, NO external calls.\"},\"withdraw(address,uint256)\":{\"details\":\"whenNotPaused: during a security incident we must prevent fund      drain while still allowing new deposits (depositFor is unguarded      because adding funds is never dangerous).\"}},\"version\":1},\"userdoc\":{\"kind\":\"user\",\"methods\":{\"CACHED_PRICE_MIN()\":{\"notice\":\"P0-11: bounds for `setCachedPrice` (ETH/USD, 8 decimals).         $100 floor guards the crash-to-zero attack where an owner         could set price=1 making every UserOp appear free. $1M ceiling         rules out off-by-1e8 typos. ±30% per-tx delta reflects ETH         intraday extremes while blocking multi-step manipulation.\"},\"MAX_ETH_USD_PRICE()\":{\"notice\":\"Maximum acceptable ETH/USD price from oracle ($100,000)\"},\"MAX_GAS_TOKENS()\":{\"notice\":\"Maximum number of supported GasTokens\"},\"MAX_SBTS()\":{\"notice\":\"Maximum number of supported SBTs\"},\"MAX_SERVICE_FEE()\":{\"notice\":\"Maximum service fee (10%)\"},\"MIN_ETH_USD_PRICE()\":{\"notice\":\"Minimum acceptable ETH/USD price from oracle ($100)\"},\"TIMESTAMP_GRACE_SECONDS()\":{\"notice\":\"Grace window for keeper-pushed timestamps (seconds).\"},\"activateInRegistry()\":{\"notice\":\"Re-list this paymaster in the active discovery listing.\"},\"balances(address,address)\":{\"notice\":\"User Internal Balances: User -> Token -> Amount (Deposit-Only Model)\"},\"cachedPrice()\":{\"notice\":\"Cached ETH/USD price for validation\"},\"calculateCost(uint256,address,bool)\":{\"notice\":\"External wrapper that respects the Realtime Flag (New Optimization)\"},\"constructor\":{\"notice\":\"Implementation contract constructor\"},\"deactivateFromRegistry()\":{\"notice\":\"Remove this paymaster from the active discovery listing.\"},\"depositFor(address,address,uint256)\":{\"notice\":\"Deposit funds for user (Push Model)\"},\"entryPoint()\":{\"notice\":\"EntryPoint contract address\"},\"ethUsdPriceFeed()\":{\"notice\":\"Chainlink ETH/USD price feedChainlink ETH/USD price feed\"},\"getSupportedTokens()\":{\"notice\":\"Get all supported token addresses\"},\"getSupportedTokensInfo()\":{\"notice\":\"Get full info for all supported tokens\"},\"initialize(address,address,address,address,uint256,uint256,uint256)\":{\"notice\":\"Initialize Paymaster (for proxy instances or direct constructor)\"},\"isActiveInRegistry()\":{\"notice\":\"True iff this paymaster is in the active discovery listing.\"},\"isRegistrySet()\":{\"notice\":\"Check if Registry is set\"},\"isTokenSupported(address)\":{\"notice\":\"Check if a token is supported\"},\"maxGasCostCap()\":{\"notice\":\"Maximum gas cost cap per transaction (in wei)\"},\"oracleDecimals()\":{\"notice\":\"Cached oracle decimals to avoid external call in validate\"},\"pause()\":{\"notice\":\"Halt sponsorship locally — `whenNotPaused` modifier on         validatePaymasterUserOp will revert all new userOps.\"},\"paused()\":{\"notice\":\"Emergency pause flag\"},\"postOp(uint8,bytes,uint256,uint256)\":{\"notice\":\"PostOp handler with refund logic\"},\"priceStalenessThreshold()\":{\"notice\":\"Price staleness threshold (seconds)\"},\"registry()\":{\"notice\":\"V3 Registry contract (immutable, set at deployment via factory)\"},\"removeToken(address)\":{\"notice\":\"Remove a supported token\"},\"serviceFeeRate()\":{\"notice\":\"Service fee rate in basis points (200 = 2%)\"},\"setCachedPrice(uint256,uint48)\":{\"notice\":\"Direct Cache Update (Operator/Keeper Pushed Price)\"},\"setTokenPrice(address,uint256)\":{\"notice\":\"Set supported token price (enable or update token)\"},\"tokenPrices(address)\":{\"notice\":\"Token Price in USD (8 decimals) set by Admin/Keeper\"},\"treasury()\":{\"notice\":\"Treasury address - service provider's collection account\"},\"updatePrice()\":{\"notice\":\"Update cached price from Oracle (Keeper only)\"},\"validatePaymasterUserOp((address,uint256,bytes,bytes,bytes32,uint256,bytes32,bytes,bytes),bytes32,uint256)\":{\"notice\":\"Validates paymaster operation and deducts internal balance\"},\"version()\":{\"notice\":\"Contract version\"},\"withdraw(address,uint256)\":{\"notice\":\"Withdraw funds\"}},\"version\":1}},\"settings\":{\"remappings\":[\"@account-abstraction-v7/=singleton-paymaster/lib/account-abstraction-v7/contracts/\",\"@chainlink/contracts/=contracts/lib/chainlink-brownie-contracts/contracts/\",\"@openzeppelin-v5.0.2/=singleton-paymaster/lib/openzeppelin-contracts-v5.0.2/\",\"@openzeppelin/contracts/=singleton-paymaster/lib/openzeppelin-contracts-v5.0.2/contracts/\",\"account-abstraction-v6/=singleton-paymaster/lib/account-abstraction-v6/contracts/\",\"account-abstraction-v7/=singleton-paymaster/lib/account-abstraction-v7/contracts/\",\"account-abstraction-v8/=singleton-paym