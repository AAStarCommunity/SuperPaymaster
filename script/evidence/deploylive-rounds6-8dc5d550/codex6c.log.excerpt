// SPDX-License-Identifier: MIT
pragma solidity 0.8.33;
import "forge-std/Test.sol";
import {VmSafe} from "forge-std/Vm.sol";
import {Ownable} from "@openzeppelin-v5.0.2/contracts/access/Ownable.sol";
import {TimelockController} from "@openzeppelin-v5.0.2/contracts/governance/TimelockController.sol";
import {TimelockHandoverBootstrap} from "../../script/v3/TimelockHandoverBootstrap.sol";
import {DeployLive} from "../../script/v3/DeployLive.s.sol";
contract Round6Safe {
    function getThreshold() external pure returns (uint256) { return 2; }
    function getOwners() external pure returns (address[] memory a) {
        a = new address[](2); a[0] = address(91); a[1] = address(92);
    }
}

interface IMintProbe { function mint(address to, uint256 amount) external; function balanceOf(address account) external view returns (uint256); }

contract ProductionHarness is DeployLive {
    bool stopForTest;
    function _configPath(string memory) internal pure override returns (string memory) {
        return "cache/deploylive-tests/config.round6-fixture.json";
    }
    function stopBeforeH() external { stopForTest = true; }
    function configure(address sender, address safe, address ep, address feed, address factory) external {
        deployer = sender; safeInput = safe; entryPointAddr = ep; priceFeedAddr = feed; simpleAccountFactory = factory;
    }
    function _addressInput(string memory k) internal view override returns (address) {
        bytes32 h = keccak256(bytes(k));
        if (h == keccak256("GOVERNANCE_OWNER")) return safeInput;
        if (h == keccak256("GUARDIAN_ADDRESS")) return address(202);
        if (h == keccak256("SP_GUARDIAN")) return address(203);
        if (h == keccak256("GENESIS_AASTAR_OPERATOR")) return address(204);
        return address(0);
    }
    function _inputSet(string memory) internal pure override returns (bool) { return false; }
    function _stringInput(string memory k) internal pure override returns (string memory) {
        bytes32 h = keccak256(bytes(k));
        if (h == keccak256("GOVERNOR_ADDRESS")) return "";
        if (h == keccak256("X402_OWNER") || h == keccak256("DEPLOYER_GTOKEN_RECIPIENT")) return "safe";
        return "timelock";
    }
    function _uintInput(string memory k) internal view override returns (uint256) {
        bytes32 h = keccak256(bytes(k));
        if (h == keccak256("DEPLOYLIVE_STOP_BEFORE_BOOTSTRAP")) return stopForTest ? 1 : 0;
        if (h == keccak256("DEPLOYLIVE_REHEARSAL")) return 1;
        if (h == keccak256("APNTS_CAP")) return 1_000_000 ether;
        if (h == keccak256("GUARDIAN_N")) return 3;
        return 2;
    }
    function _guardiansInput() internal pure override returns (bytes memory) {
        GuardianInput[] memory gs = new GuardianInput[](3);
        for (uint256 i; i < 3; ++i) { gs[i].account = address(uint160(300 + i)); gs[i].key.x_b = bytes32(i + 1); }
        return abi.encode(gs);
    }
    function makePins(string memory path) external {
        string[24] memory names = _pinnedNames();
        for (uint256 i; i < names.length; ++i) vm.serializeBytes32("production-pins", names[i], keccak256(vm.getCode(_defaultArtifact(names[i]))));
        vm.writeFile(path, vm.serializeBytes32("production-pins", "TimelockHandoverBootstrap", keccak256(type(TimelockHandoverBootstrap).creationCode)));
    }
    function failedCreate(address externalGToken, address externalAPNTs) external {
        vm.store(address(registry), 0xdb5a3168abaa6147a9f3a4cb66016161119d4d50b6393344d27120286f742a00, bytes32(0));
        require(vm.getNonce(deployer) == bootstrapNonce, "failure: storage write nonce");
        vm.startBroadcast(deployer);
        vm.expectRevert();
        new TimelockHandoverBootstrap(TimelockController(payable(timelockControllerAddr)), _twoStepTargets(), safeInput);
        vm.stopBroadcast();
        require(bootstrapAddr.code.length == 0, "failure: H has code");
        address[27] memory all = [address(registry), registryImplAddr, address(superPaymaster), spImplAddr,
            superPaymaster.EXTENSION(), address(gtoken), address(staking), address(mysbt), address(apnts),
            address(xpntsFactory), xpntsFactory.implementation(), v55.factory, v55.impl, v55.ext, v55.tierSource,
            v55.lens, v55.aoaRegistry, address(repSystem), address(aggregator), address(dvt), address(microPaymentCh),
            address(pmFactory), address(pmV4Impl), x402FacilitatorAddr, policyRegistryAddr, timelockControllerAddr, bootstrapAddr];
        for (uint256 i; i < all.length; ++i) {
            require(all[i].balance == 0, "failure: ETH residue");
            require(IMintProbe(externalGToken).balanceOf(all[i]) == 0 && IMintProbe(externalAPNTs).balanceOf(all[i]) == 0,
                "failure: pre-existing token residue");
            console2.log("ABANDONED contract", all[i]);
            console2.log("ETH / prior GToken / prior APNTs", uint256(0), uint256(0), uint256(0));
            console2.log("own GToken / own APNTs", gtoken.balanceOf(all[i]), apnts.balanceOf(all[i]));
        }

        TimelockController t = TimelockController(payable(timelockControllerAddr));
        bytes32[3] memory roles = [t.PROPOSER_ROLE(), t.EXECUTOR_ROLE(), t.CANCELLER_ROLE()];
        for (uint256 i; i < roles.length; ++i) {
            require(t.hasRole(roles[i], bootstrapAddr) && !t.hasRole(roles[i], safeInput) && !t.hasRole(roles[i], deployer), "failure: authority");
        }
        require(registry.hasRole(keccak256("COMMUNITY"), genesisInput) && registry.hasRole(keccak256("PAYMASTER_SUPER"), genesisInput), "failure: genesis registrations");
        for (uint256 i; i < guardiansInput.length; ++i) require(registry.hasRole(keccak256("DVT"), guardiansInput[i].account), "failure: guardian registration");
    }
    function probeAssertion(uint256 kind, uint256 slot) external {
        if (kind == 0) vm.mockCall(x402FacilitatorAddr, abi.encodeWithSignature("owner()"), abi.encode(address(999)));
        if (kind == 1) vm.mockCall(_singleStepTargets()[slot], abi.encodeWithSignature("owner()"), abi.encode(address(999)));
        if (kind == 2) vm.mockCall(address(gtoken), abi.encodeWithSignature("totalSupply()"), abi.encode(uint256(1)));
        if (kind == 3) vm.mockCall(address(staking), abi.encodeWithSignature("getLockedStake(address,bytes32)", stakeAccounts[slot], stakeRoles[slot]), abi.encode(uint256(1)));
        if (kind == 4) ticketTreasuries[slot] = address(999);
        if (kind == 5) vm.mockCall(address(gtoken), abi.encodeWithSignature("balanceOf(address)", address(staking)), abi.encode(uint256(1)));
        if (kind == 6) ++gtokenTransferred;
        if (kind == 7) vm.mockCall(address(gtoken), abi.encodeWithSignature("balanceOf(address)", deployer), abi.encode(uint256(1)));
        if (kind == 8) vm.mockCall(address(gtoken), abi.encodeWithSignature("balanceOf(address)", gtokenRecipient), abi.encode(uint256(1)));
        if (kind == 9) vm.mockCall(address(aggregator), abi.encodeWithSignature("slashPolicyAdmin()"), abi.encode(address(999)));
        if (kind == 10) {
            address[] memory owners = new address[](2); owners[0] = deployer; owners[1] = address(92);
            vm.mockCall(safeInput, abi.encodeWithSignature("getOwners()"), abi.encode(owners));
        }
        _assertHandover();
    }
    function verifyRound6() external view {
        require(aggregator.owner() == safeInput && dvt.owner() == safeInput, "round6: Safe owners");
        require(Ownable(x402FacilitatorAddr).owner() == safeInput, "round6: X402 owner");
        require(gtoken.balanceOf(deployer) == 0, "round6: residue");
        require(gtoken.balanceOf(safeInput) == 2059 ether, "round6: recipient");
        require(gtoken.totalSupply() == 2199 ether, "round6: minted supply");
        require(staking.getLockedStake(address(204), keccak256("PAYMASTER_SUPER")) == 50 ether, "round6: genesis stake");
        for (uint256 i; i < 3; ++i) require(staking.getLockedStake(address(uint160(300 + i)), keccak256("DVT")) == 30 ether, "round6: DVT stake");
        _assertHandover();
    }
}

contract DeployLiveProductionTest is Test {
    function test_ProductionPathN3() public {
        vm.chainId(987654); vm.warp(10000);
        address sender = tx.origin;
        address safe = address(new Round6Safe());
        vm.setEnv("GOVERNANCE_OWNER", vm.toString(safe));
        vm.setEnv("ENV", "round6-fixture");
        address ep = 0x0000000071727De22E5E9d8BAf0edAc6f37da032;
        address feed = address(100); address factory = address(101); address impl = address(102);
        vm.etch(ep, hex"00"); vm.etch(feed, hex"00"); vm.etch(factory, hex"00"); vm.etch(impl, hex"00");
        vm.mockCall(feed, abi.encodeWithSignature("decimals()"), abi.encode(uint8(8)));
        vm.mockCall(feed, abi.encodeWithSignature("latestRoundData()"), abi.encode(uint80(1), int256(2000e8), block.timestamp, block.timestamp, uint80(1)));
        vm.mockCall(factory, abi.encodeWithSignature("accountImplementation()"), abi.encode(impl));
        vm.mockCall(impl, abi.encodeWithSignature("entryPoint()"), abi.encode(ep));
        // Cryptography boundary only: this tests production orchestration, not PoP validity.
        vm.mockCall(address(0x0b), "", new bytes(128));
        vm.mockCall(address(0x0c), "", new bytes(128));
        vm.mockCall(address(0x0d), "", new bytes(256));
        vm.mockCall(address(0x11), "", new bytes(256));
        vm.mockCall(address(0x0f), "", abi.encode(uint256(1)));
        ProductionHarness h = new ProductionHarness();
        h.configure(sender, safe, ep, feed, factory);
        string memory pins = "contracts/test/fixtures/deploylive/production-pins.json";
        vm.createDir("cache/deploylive-tests", true); vm.setEnv("CREATION_PINS", pins); vm.setEnv("DEPLOYLIVE_EVM_VERSION", "cancun");
        vm.startStateDiffRecording();
        h.run();
        VmSafe.AccountAccess[] memory records = vm.stopAndReturnStateDiff();
        string memory config = vm.readFile("cache/deploylive-tests/config.round6-fixture.json");
        address bootstrap = vm.parseJsonAddress(config, ".handoverBootstrap");
        address tl = vm.parseJsonAddress(config, ".timelockController");
        uint256 distance; bool sawTL; bool sawH; uint256 transactions;
        string memory journal = "[";
        for (uint256 i; i < records.length; ++i) {
            VmSafe.AccountAccess memory record = records[i];
            if (record.accessor != sender || (record.kind != VmSafe.AccountAccessKind.Call && record.kind != VmSafe.AccountAccessKind.Create)) continue;
            if (record.account == bootstrap && record.kind == VmSafe.AccountAccessKind.Create) { sawH = true; break; }
            assertEq(record.value, 0, "pre-H broadcast value");
            if (transactions++ > 0) journal = string.concat(journal, ",");
            journal = string.concat(journal, '{"to":"', vm.toString(record.account), '","value":', vm.toString(record.value), '}');
            if (record.account == tl && record.kind == VmSafe.AccountAccessKind.Create) sawTL = true;
            if (sawTL) ++distance;
        }
        assertTrue(sawTL && sawH, "complete TL-to-H record required");
        assertEq(distance, 22, "derived call-list distance");
        assertEq(vm.parseJsonUint(config, ".observedBootstrapNonce"), vm.parseJsonUint(config, ".handoverBootstrapNonce"));
        vm.writeFile("cache/deploylive-tests/production-transactions.json", string.concat(journal, "]"));
        emit log_named_uint("pre-H zero-value transactions", transactions);
        emit log_named_uint("TL-to-H observed distance", distance);
        h.verifyRound6();
        vm.prank(sender);
        vm.expectRevert(abi.encodeWithSignature("OwnableUnauthorizedAccount(address)", sender));
        IMintProbe(vm.parseJsonAddress(config, ".gToken")).mint(sender, 1);
        vm.writeFile("cache/deploylive-tests/config.success.json", config);
        vm.chainId(31337);
        ProductionHarness failed = new ProductionHarness();
        failed.configure(sender, safe, ep, feed, factory); failed.stopBeforeH();
        failed.run(); failed.failedCreate(vm.parseJsonAddress(config, ".gToken"), vm.parseJsonAddress(config, ".aPNTs"));
        vm.writeFile("cache/deploylive-tests/config.abandoned.json", vm.readFile("cache/deploylive-tests/config.round6-fixture.json"));
        vm.removeFile("cache/deploylive-tests/config.round6-fixture.json");
        string[11] memory errors = ["handover: facilitator owner", "handover: single owner", "handover: mint accounting",
            "handover: stake accounting", "handover: ticket treasury", "handover: GToken conservation",
            "handover: GToken conservation", "handover: deployer GToken balance", "handover: recipient GToken delta",
            "handover: slash admin", "DeployLive: deployer is Safe owner"];
        bool allRejected = true;
        for (uint256 kind; kind < errors.length; ++kind) {
            uint256 slots = kind == 1 ? 10 : kind == 3 || kind == 4 ? 6 : 1;
            for (uint256 slot; slot < slots; ++slot) {
                (bool ok, bytes memory reason) = address(h).call(abi.encodeCall(h.probeAssertion, (kind, slot)));
                bool rejected = !ok && keccak256(reason) == keccak256(abi.encodeWithSignature("Error(string)", errors[kind]));
                emit log_named_string(rejected ? "ASSERTION PASS" : "ASSERTION FAIL", errors[kind]);
                emit log_named_uint("slot", slot);
                allRejected = allRejected && rejected;
                vm.clearMockedCalls();
            }
        }
        assertTrue(allRejected, "per-assertion negative controls");
    }
}
# DeployLive round 6b validation

Scope: build on the uncommitted round-six work in rc8-dl. The per-file delta below
uses a worktree snapshot taken at the start of this round, not HEAD. No formatter,
git writes, network, RPC, keystore or .env access. All Forge commands use `--offline`.
No `contracts/src` changes. H is frozen; no edits were made to it.

## Changes

- The prediction site passes `beforeV54 + 9` and its CREATE address into handover.
  After the six transfers, the live nonce and CREATE address must match those
  predictions **before CREATE TL**. Negative tests insert a real local deployer
  transaction or provide a wrong predicted address, require the precise rejection,
  inspect state-diff records for any attempted CREATE, and check absent TL code.
  The existing production transaction walk still independently derives distance 22.
- Safe-compatible M-of-N validation reads `getOwners()` and rejects the deployer,
  both before broadcast and during final handover assertions. The checker reads it
  independently. Its role-overlap table is INFO only and lists every repeated
  address across Safe owners, guardians, SP guardian, guardian address, genesis,
  deployer, recipient, governance owner and all five explicit owner inputs.
- The actual subjects builder used by `_assertHandover` returns exactly `N + 6`
  entries. A focused test gives every subject a distinct nonzero address and
  verifies all nine entries, including index 6. Production's governor slot is
  deliberately assigned `governorInput` (zero under the removed governor input);
  it is not an unassigned gap.
- Both disclosures explain that a remaining GToken balance lets the deployer
  re-approve staking and pay the 30 GToken ticket through permissionless
  `registerRole` to register itself as COMMUNITY again.

## Fixtures and output isolation

The committed inputs are small files under `contracts/test/fixtures/deploylive/`:
`production-pins.json`, `test-pins.json`, and `tampered-timelock.json`. The first two
are the round-six release pins, now read directly rather than regenerated over the
expected values. The last contains only a deliberately invalid creation bytecode.
Compiled release artifacts are still read from Foundry's ignored `out/` directory.

All generated test records, writable pin copies and Python temporary directories
are under `cache/deploylive-tests/`. The production harness overrides only the config
output path; normal deployment config paths retain their existing behavior. Existing
`.gitignore` entry `cache/` covers every output, and Foundry's existing `./` read-write
fs_permission covers that directory. No new ignore/permission exception was needed.
The old rehearsal evidence directory is deleted and no test reads from it.

The round-six logs are excluded from the repository's deliverable files. They are
preserved in ignored `cache/deploylive-tests/round6-archive/`. **They have not been
moved physically outside the worktree:** this session's explicit restriction permits
writing only inside this worktree. An external archive move must be done by a session
allowed to write there; claiming it happened here would be false. Round-6b full logs
and the starting snapshot are in ignored `cache/deploylive-tests/round6b/`.

## Fail-first and retrospective evidence

L-1 and L-2 tests were run before implementing their checks. Original implementation:

```text
[FAIL: next call did not revert as expected] test_Round6bSafeOwnerCannotBeDeployer() (gas: 3307728)
[FAIL: Error != expected error: handover: bootstrap nonce != handover: timelock nonce] test_Round6bExtraTransactionRejectedBeforeTimelockCreate() (gas: 26383742)
[FAIL: Error != expected error: handover: bootstrap nonce != handover: predicted timelock before CREATE] test_Round6bWrongPredictionRejectedBeforeTimelockCreate() (gas: 26381663)
Ran 17 tests in 0.793s
FAILED (failures=2)
SUMMARY 157 passed, 0 failed, 157 total
```

The first nonce harness used mocked calls; it was subsequently strengthened to real
local transactions because mocked calls do not consume the broadcast nonce. Final
mutation runs repeat both negative cases with the real-transaction harness. Logs:
`red-safe.log`, `red-nonce.log`, `red-checker.log`, `red-solidity-assertions.log`.

Round six had no individual red evidence for these changed/new `_assertHandover`
assertions: facilitator owner; each single-step owner; Safe owner gate; mint
accounting; each stake accounting entry; each ticket treasury; both GToken
conservation predicates; zero deployer balance; exact recipient delta; and resolved
slash admin. The new tests corrupt each value and require its specific error.
Removing the corresponding assertions together produces individually logged failures:
10 single-owner slots, 6 stake entries, 6 treasury entries, and each scalar predicate.
The final Safe-owner recheck is exercised independently after successful deployment.
The subjects regression is also tested with the former `N + 7` / offset-7 mutation.
These are **retrospective mutation controls**, not a claim that round six was
implemented test-first.

**Specific exception — Safe owner gate:** it is redundant with earlier checks.
An incorrect owner for any of its five targets fails `handover: single owner` first;
a bad Safe threshold, owner list, code or delegation prefix fails `_validateSafe`
first. With those predecessors intact and stable contract readbacks, no fixture state
independently reaches and fails this gate. An inconsistent, gas-dependent malicious
getter would be a different behavior, not the stable-state authority mutation tested here. Its required behavior is covered by those earlier negative
checks, but no independent red evidence is claimed for the redundant require itself.
H was not changed to manufacture a reachable failure.

Checker assertions that lacked individual red evidence at round-six completion:
all five `*_OWNER`/slash-admin resolved-contract checks; zero recorded deployer GToken
balance even when the live balance agrees; totalSupply versus mints; each stake
readback; conservation; rejected deployer mint; and Registry/SP recorded implementation
owner equality. The new named negative cases cover each. Existing recipient delta,
mint ledger, ticket ledger and mint-event cases now also demand the exact FAIL label.
Disabling those checks produces 25 failures (`red-checker-assertions.log`).
Input-guard removal produces 15 failures and 4 errors (`red-checker-inputs.log`):
malformed values either reach the missing guard's consumer or are wrongly accepted.
New numeric keys and all three numeric arrays each have named subtests. Existing
owner-slot tests cover every changed owner expectation. INFO and N/A lines are
output contracts, not failure assertions; their tests require the expected text.

## Local evidence limits

The production fixture uses the real local EVM deployment sequence and contracts,
with infrastructure and BLS boundaries mocked. It is neither a broadcast nor a
fork. N=3 still mints 2199 GToken, locks 140, transfers 2059, and leaves deployer
balance and staking allowance zero. The failed-H rehearsal and asset inventory
remain covered. No genuine PoP or network deployment is claimed.

The token scanner cannot prove absence of nonstandard tokens without Transfer
logs; direct Forge callers must keep the recorded EVM version consistent with
flags. Those existing limits are unchanged. H's runtime remains 16 bytes.

