 table='| File | Added | Deleted |\\n|---|---:|---:|\\n'+'\\n'.join(rows)+'\\n'
 s=p.read_text()
 if 'LINE_COUNTS' in s:s=s.replace('LINE_COUNTS',table)
 else:s=s[:s.index('| File | Added | Deleted |')]+table
 p.write_text(s)
(root/'line-counts.md').write_text(table)
print(table)
print(build)
print((root/'python-final.log').read_text())
