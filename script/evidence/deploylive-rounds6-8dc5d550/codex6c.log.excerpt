results+=\""'`forge test --offline --match-path '"'contracts/test/scripts/DeployLive*.t.sol'"'` (exit 0):'"\\n\\n"'```text'"\\n\"+forge+'\\n"'```'"\\n\\n'
for pattern,log in [('test_deploylive*.py','python-final.log'),('test_creation_pins.py','pins-final.log')]:
 results+=f\""'`python3 -m unittest discover -s script/rehearsal -p '"'{pattern}'"'` (exit 0):'"\\n\\n"'```text'"\\n\"+(root/log).read_text().strip()+'\\n"'```'"\\n\\n'
results+='Production fixture measurements (each recipient scenario):\\n\\n"'```text'"\\n'+ '\\n'.join(next(l for l in (root/'forge-final.log').read_text().splitlines() if l.strip().startswith(prefix)).strip() for prefix in ['pre-H zero-value transactions:','TL-to-H observed distance:','ticketsToTreasury:','deployerRemainderToRecipient:'])+'\\n"'```'"'
