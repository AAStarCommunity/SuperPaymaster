import hashlib
import io
import json
from pathlib import Path
import runpy
import sys
import unittest
from unittest.mock import patch
from types import SimpleNamespace

CHECKER = Path(__file__).with_name("deploylive_postdeploy_check.py")
ZERO = "0x" + "0" * 40

def addr(n):
    return "0x" + f"{n:040x}"

def digest(s):
    return "0x" + hashlib.sha256(s.encode()).hexdigest()

